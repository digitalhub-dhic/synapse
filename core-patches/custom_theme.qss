/* ==========================================================================
   SYNAPSE COMMAND — ENTERPRISE FLEET MANAGEMENT DARK STYLESHEET
   ========================================================================== */

QMainWindow, QWidget#centralWidget {
    background-color: #090E1A;
}

QToolBar#headerToolBar {
    background-color: #090E1A;
    border-bottom: 1px solid #1E293B;
    padding: 2px 10px;
    min-height: 42px;
    max-height: 42px;
}

QToolBar#headerToolBar QToolButton {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 4px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0px;
}

QToolBar {
    background-color: #0F172A;
    border-bottom: 1px solid #1E293B;
    padding: 3px 6px;
    spacing: 4px;
}

QToolBar#toolBar {
    min-height: 56px;
    max-height: 56px;
}

QToolBar#mainToolBar QToolButton, QToolBar#toolBar QToolButton {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 4px;
    color: #F8FAFC;
    font-weight: 500;
    font-size: 9.5px;
    padding: 3px 2px 2px 2px;
    min-width: 56px;
    max-width: 76px;
    min-height: 46px;
    max-height: 48px;
}

QToolBar#mainToolBar QToolButton:hover, QToolBar#toolBar QToolButton:hover {
    background-color: #1E293B;
    border-color: #2563EB;
    color: #FFFFFF;
}

QToolBar#toolBar QToolButton[objectName*="powerDown"]:hover {
    background-color: #381014;
    border-color: #EF4444;
    color: #FCA5A5;
}

QToolBar#toolBar QToolButton[objectName*="reboot"]:hover {
    background-color: #38240D;
    border-color: #F59E0B;
    color: #FCD34D;
}

QToolBar#mainToolBar QToolButton:checked, QToolBar#toolBar QToolButton:checked {
    background-color: #2563EB;
    border: 1px solid #3B82F6;
    color: #FFFFFF;
    font-weight: 600;
}

QToolBar#mainToolBar QToolButton:disabled, QToolBar#toolBar QToolButton:disabled {
    background-color: #090E1A;
    border-color: #1E293B;
    color: #64748B;
}

QToolBar::separator {
    width: 1px;
    height: 22px;
    background-color: #1E293B;
    border: none;
    margin: 4px 4px;
}

QToolBar::separator:horizontal {
    width: 1px;
    height: 22px;
    background-color: #1E293B;
    border: none;
    margin: 4px 4px;
}

QToolBar::separator:vertical {
    height: 1px;
    width: 22px;
    background-color: #1E293B;
    border: none;
    margin: 4px 4px;
}

QToolTip {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 10px;
}

QToolButton::menu-indicator {
    image: none;
    width: 0px;
    height: 0px;
}

/* Remote Access / Monitoring Window HUD ToolBar */
QWidget#remoteAccessToolBar {
    background-color: #090E1A;
    border-bottom: 1px solid #1E293B;
}

QWidget#remoteAccessToolBar QToolButton {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 4px;
    color: #F8FAFC;
    font-size: 11px;
    font-weight: 500;
    padding: 4px 10px;
    min-height: 26px;
    max-height: 30px;
    min-width: 70px;
}

QWidget#remoteAccessToolBar QToolButton:hover {
    background-color: #1E293B;
    border-color: #2563EB;
    color: #FFFFFF;
}

QWidget#remoteAccessToolBar QToolButton:checked {
    background-color: #2563EB;
    border: 1px solid #3B82F6;
    color: #FFFFFF;
}

QWidget#remoteAccessToolBar QToolButton#exitButton {
    background-color: #1F1315;
    border-color: #7F1D1D;
    color: #F87171;
}

QWidget#remoteAccessToolBar QToolButton#exitButton:hover {
    background-color: #DC2626;
    border-color: #EF4444;
    color: #FFFFFF;
}

QMenu {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 5px 20px;
    border-radius: 3px;
    color: #F8FAFC;
    font-size: 11px;
}

QMenu::item:selected {
    background-color: #2563EB;
    color: #FFFFFF;
}

QStatusBar, QWidget#panelButtons {
    background-color: #090E1A;
    border-top: 1px solid #1E293B;
    color: #94A3B8;
    min-height: 28px;
    padding: 2px 8px;
}

QStatusBar QToolButton, QWidget#panelButtons QToolButton {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 4px;
    padding: 3px 8px;
    color: #F8FAFC;
    font-size: 10px;
    font-weight: 500;
}

QStatusBar QToolButton:hover, QWidget#panelButtons QToolButton:hover {
    background-color: #1E293B;
    color: #F8FAFC;
    border-color: #2563EB;
}

QStatusBar QToolButton:checked, QWidget#panelButtons QToolButton:checked {
    background-color: #2563EB;
    border: 1px solid #3B82F6;
    color: #FFFFFF;
    font-weight: 600;
}

QStatusBar QLabel {
    color: #94A3B8;
    font-size: 10px;
}

QStatusBar QLineEdit, QLineEdit#filterLineEdit, QLineEdit {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 4px;
    padding: 3px 8px;
    color: #F8FAFC;
    font-size: 11px;
}

QStatusBar QLineEdit:focus, QLineEdit#filterLineEdit:focus, QLineEdit:focus {
    border-color: #2563EB;
    background-color: #090E1A;
}

QStatusBar QSlider::groove:horizontal, QSlider::groove:horizontal {
    height: 4px;
    background: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 2px;
}

QStatusBar QSlider::sub-page:horizontal, QSlider::sub-page:horizontal {
    background: #2563EB;
    border-radius: 2px;
}

QStatusBar QSlider::handle:horizontal, QSlider::handle:horizontal {
    background: #F8FAFC;
    border: 1px solid #2563EB;
    width: 12px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 6px;
}

QStatusBar QSlider::handle:horizontal:hover, QSlider::handle:horizontal:hover {
    background: #FFFFFF;
    border-color: #3B82F6;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 1px;
    background-color: #1E293B;
}

QSplitter::handle:vertical {
    height: 1px;
    background-color: #1E293B;
}

QSplitter::handle:hover {
    background-color: #2563EB;
}

QTreeView, QListView, QTableView {
    background-color: #090E1A;
    color: #F8FAFC;
    border: none;
    font-size: 11px;
}

QTreeView::item:hover, QListView::item:hover {
    background-color: #1A2742;
    color: #FFFFFF;
}

QTreeView::item:selected, QListView::item:selected {
    background-color: #172B4D;
    color: #FFFFFF;
    font-weight: 600;
}

QHeaderView::section {
    background-color: #0F172A;
    color: #94A3B8;
    border: 1px solid #1E293B;
    padding: 4px;
}

QPushButton {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 4px;
    padding: 3px 8px;
    color: #F8FAFC;
    font-size: 10px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #1E293B;
    border-color: #2563EB;
    color: #FFFFFF;
}

QPushButton:checked {
    background-color: #2563EB;
    border: 1px solid #3B82F6;
    color: #FFFFFF;
    font-weight: 600;
}

QScrollBar:vertical {
    background: #090E1A;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #1E293B;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #2563EB;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #090E1A;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #1E293B;
    min-width: 20px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #2563EB;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QAbstractScrollArea::corner {
    background: #090E1A;
    border: none;
}

/* Panels and subheaders */
ComputerSelectPanel, QWidget#ComputerSelectPanel {
    background-color: #0F172A;
    border-right: 1px solid #1E293B;
}

ComputerInspectorPanel, QWidget#ComputerInspectorPanel {
    background-color: #0F172A;
    border-left: 1px solid #1E293B;
}

QFrame#selectHeader, QFrame#inspectorHeader, QFrame#subHeader {
    background-color: #090E1A;
    border-bottom: 1px solid #1E293B;
}

QLineEdit#filterLineEdit {
    margin: 0px 8px;
}

QPushButton#saveListButton {
    margin: 0px 8px;
}

/* Modals, Dialogs, SpinBoxes & Buttons */
QDialog {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
}

QDialog QLabel {
    color: #F8FAFC;
    font-size: 11px;
}

QSpinBox, QDoubleSpinBox, QDialog QSpinBox, QDialog QDoubleSpinBox {
    background-color: #090E1A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 4px;
    padding: 3px 6px;
    font-size: 11px;
    font-weight: bold;
    min-width: 60px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2563EB;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: #1E293B;
    border: none;
    width: 16px;
}

QDialog QPushButton, QDialog QDialogButtonBox QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 11px;
    border: 1px solid #3B82F6;
    border-radius: 4px;
    padding: 5px 14px;
    min-width: 70px;
}

QDialog QPushButton:hover, QDialog QDialogButtonBox QPushButton:hover {
    background-color: #1D4ED8;
}

QDialog QPushButton[text*="Cancel"], QDialog QDialogButtonBox QPushButton[text*="Cancel"] {
    background-color: #0F172A;
    color: #94A3B8;
    border: 1px solid #1E293B;
}

QDialog QPushButton[text*="Cancel"]:hover, QDialog QDialogButtonBox QPushButton[text*="Cancel"]:hover {
    background-color: #1E293B;
    color: #F8FAFC;
}

QDialog QLineEdit {
    background-color: #090E1A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

QDialog QTextEdit, QDialog QPlainTextEdit {
    background-color: #090E1A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

QLabel {
    color: #F8FAFC;
}
