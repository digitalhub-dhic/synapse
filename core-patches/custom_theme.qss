/* =====================================
   SYNAPSE COMMAND
   Warm Sage Light Theme (100% Blue-Free)
   ===================================== */

QMainWindow,
QWidget#centralWidget {
    background-color: #F3F2EB;
    color: #27352A;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}

QFrame#sidebar {
    background-color: #EAECE3;
    border: none;
    border-right: 1px solid #DCDDD2;
}

QFrame#toolbar,
QToolBar#headerToolBar,
QToolBar#toolBar {
    background-color: #F8F7F1;
    border: none;
    border-bottom: 1px solid #DCDDD2;
}

QFrame#deviceCard {
    background-color: #FFFFFF;
    border: 1px solid #DCDDD2;
    border-radius: 12px;
}

QFrame#deviceCard:hover {
    border: 1px solid #9CB59B;
    background-color: #FEFFFC;
}

QFrame#deviceCard[selected="true"] {
    background-color: #F0F4EB;
    border: 1px solid #537B5B;
}

QPushButton {
    background-color: #FFFFFF;
    color: #27352A;
    border: 1px solid #DCDDD2;
    border-radius: 8px;
    padding: 8px 14px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #E5EDE1;
    border-color: #9CB59B;
}

QPushButton:pressed {
    background-color: #DCE7D8;
}

QPushButton:disabled {
    color: #92988C;
    background-color: #ECEDE8;
    border-color: #E1E2D9;
}

QPushButton#primaryButton {
    background-color: #537B5B;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #426749;
}

QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #DCDDD2;
    border-radius: 10px;
}

QTabBar::tab {
    background-color: transparent;
    color: #657064;
    padding: 10px 16px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: #426749;
    font-weight: 600;
    border-bottom: 2px solid #537B5B;
}

QTabBar::tab:hover {
    background-color: #E5EDE1;
}

QLineEdit,
QComboBox,
QSpinBox {
    background-color: #FFFFFF;
    color: #27352A;
    border: 1px solid #DCDDD2;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: #537B5B;
    selection-color: #FFFFFF;
}

QLineEdit:focus,
QComboBox:focus {
    border: 1px solid #537B5B;
}

QTableWidget,
QTreeWidget,
QListWidget,
QTreeView,
QListView {
    background-color: #FFFFFF;
    alternate-background-color: #F8F7F1;
    color: #27352A;
    border: 1px solid #DCDDD2;
    border-radius: 10px;
    gridline-color: #E6E5DC;
    outline: none;
}

QHeaderView::section {
    background-color: #F3F2EB;
    color: #657064;
    border: none;
    padding: 10px;
    font-weight: 600;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #C6CABC;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #9CB59B;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QToolTip {
    background-color: #27352A;
    color: #FFFFFF;
    border: none;
    padding: 6px 9px;
    border-radius: 5px;
}
