
QMainWindow, QWidget#centralWidget {
    background-color: #090E1A;
}
QToolBar#headerToolBar {
    background-color: #090E1A;
    border-bottom: 1px solid #21262D;
    padding: 2px 10px;
    min-height: 42px;
    max-height: 42px;
}
QToolBar#headerToolBar QToolButton {
    background-color: #0F172A;
    border: 1px solid #2A323D;
    border-radius: 4px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0px;
}
QToolBar {
    background-color: #0F172A;
    border-bottom: 1px solid #21262D;
    padding: 3px 6px;
    spacing: 4px;
}
QToolBar#toolBar {
    min-height: 56px;
    max-height: 56px;
}
QToolBar QToolButton#qt_toolbar_ext_button {
    qproperty-visible: false;
    width: 0px;
    max-width: 0px;
    min-width: 0px;
    height: 0px;
    max-height: 0px;
    min-height: 0px;
    border: none;
    background: transparent;
    padding: 0px;
    margin: 0px;
}

QToolBar#mainToolBar QToolButton, QToolBar#toolBar QToolButton {
    background-color: #0F172A;
    border: 1px solid #2A323D;
    border-radius: 8px;
    color: #E6EDF3;
    font-weight: 500;
    font-size: 9.5px;
    padding: 3px 2px 2px 2px;
    min-width: 56px;
    max-width: 76px;
    min-height: 46px;
    max-height: 48px;
}
QToolBar#mainToolBar QToolButton:hover, QToolBar#toolBar QToolButton:hover {
    background-color: #1F2630;
    border-color: #2563EB;
    color: #FFFFFF;
}
QToolBar#toolBar QToolButton[objectName*="powerDown"]:hover {
    background-color: #381014;
    border-color: #EF4444;
    color: #FCA5A5;
}
QToolBar#toolBar QToolButton[objectName*="reboot"]:hover {
    background-color: #38240D;
    border-color: #F59E0B;
    color: #FCD34D;
}
QToolBar#mainToolBar QToolButton:checked, QToolBar#toolBar QToolButton:checked {
    background-color: #2563EB;
    border: 1px solid #2563EB;
    color: #FFFFFF;
    font-weight: 600;
}
QToolBar#mainToolBar QToolButton:disabled, QToolBar#toolBar QToolButton:disabled {
    background-color: #090E1A;
    border-color: #2A323D;
    color: #8B949E;
}
QToolBar::separator {
    width: 1px;
    height: 28px;
    background-color: #21262D;
    border: none;
    margin: 6px 4px;
}
QToolBar::separator:horizontal {
    width: 1px;
    height: 28px;
    background-color: #21262D;
    border: none;
    margin: 6px 4px;
}
QToolBar::separator:vertical {
    height: 1px;
    width: 28px;
    background-color: #21262D;
    border: none;
    margin: 4px 6px;
}
QToolTip {
    background-color: #0F172A;
    color: #E6EDF3;
    border: 1px solid #2A323D;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 11px;
}
QToolButton::menu-indicator {
    image: none;
    width: 0px;
    height: 0px;
}
/* Remote Access / Monitoring Window HUD ToolBar */
QWidget#remoteAccessToolBar {
    background-color: #090E1A;
    border-bottom: 1px solid #21262D;
}
QWidget#remoteAccessToolBar QToolButton {
    background-color: #0F172A;
    border: 1px solid #2A323D;
    border-radius: 6px;
    color: #E6EDF3;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 12px;
    min-height: 28px;
    max-height: 32px;
    min-width: 80px;
}
QWidget#remoteAccessToolBar QToolButton:hover {
    background-color: #1F2630;
    border-color: #2563EB;
    color: #FFFFFF;
}
QWidget#remoteAccessToolBar QToolButton:checked {
    background-color: #2563EB;
    border: 1px solid #2563EB;
    color: #FFFFFF;
}
QWidget#remoteAccessToolBar QToolButton#exitButton {
    background-color: #1E1218;
    border-color: #5C1D24;
    color: #F87171;
}
QWidget#remoteAccessToolBar QToolButton#exitButton:hover {
    background-color: #DC2626;
    border-color: #EF4444;
    color: #FFFFFF;
}
QMenu {
    background-color: #0F172A;
    border: 1px solid #2A323D;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    color: #E6EDF3;
    font-size: 12px;
}
QMenu::item:selected {
    background-color: #2563EB;
    color: #FFFFFF;
}
QStatusBar, QWidget#panelButtons {
    background-color: #090E1A;
    border-top: 1px solid #21262D;
    color: #8B949E;
    min-height: 38px;
    padding: 2px 8px;
}
QStatusBar QToolButton, QWidget#panelButtons QToolButton {
    background-color: #0F172A;
    border: 1px solid #2A323D;
    border-radius: 6px;
    padding: 4px 8px;
    color: #E6EDF3;
    font-size: 11px;
    font-weight: 600;
}
QStatusBar QToolButton:hover, QWidget#panelButtons QToolButton:hover {
    background-color: #1F2630;
    color: #E6EDF3;
    border-color: #2563EB;
}
QStatusBar QToolButton:checked, QWidget#panelButtons QToolButton:checked {
    background-color: #2563EB;
    border: 1px solid #2563EB;
    color: #FFFFFF;
    font-weight: 600;
}
QStatusBar QLabel {
    color: #8B949E;
    font-size: 11px;
}
QStatusBar QLineEdit, QLineEdit#filterLineEdit, QLineEdit {
    background-color: #0F172A;
    border: 1px solid #2A323D;
    border-radius: 6px;
    padding: 4px 10px;
    color: #E6EDF3;
    font-size: 11px;
}
QStatusBar QLineEdit:focus, QLineEdit#filterLineEdit:focus, QLineEdit:focus {
    border-color: #2563EB;
    background-color: #090E1A;
}
QStatusBar QSlider::groove:horizontal, QSlider::groove:horizontal {
    height: 6px;
    background: #0F172A;
    border: 1px solid #2A323D;
    border-radius: 3px;
}
QStatusBar QSlider::sub-page:horizontal, QSlider::sub-page:horizontal {
    background: #2563EB;
    border-radius: 3px;
}
QStatusBar QSlider::handle:horizontal, QSlider::handle:horizontal {
    background: #E6EDF3;
    border: 1px solid #2563EB;
    width: 14px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}
QStatusBar QSlider::handle:horizontal:hover, QSlider::handle:horizontal:hover {
    background: #FFFFFF;
    border-color: #2563EB;
}
QSplitter::handle {
    background-color: transparent;
}
QSplitter::handle:horizontal {
    width: 1px;
    background-color: #21262D;
}
QSplitter::handle:vertical {
    height: 1px;
    background-color: #21262D;
}
QSplitter::handle:hover {
    background-color: #21262D;
}
QTreeView, QListView, QTableView {
    background-color: #090E1A;
    color: #E6EDF3;
    border: none;
    font-size: 11px;
}
QTreeView::item:hover, QListView::item:hover {
    background-color: #1F2630;
    color: #FFFFFF;
}
QTreeView::item:selected, QListView::item:selected {
    background-color: #173424;
    color: #FFFFFF;
    font-weight: 600;
}
QHeaderView::section {
    background-color: #0F172A;
    color: #8B949E;
    border: 1px solid #21262D;
    padding: 4px;
}
QPushButton {
    background-color: #0F172A;
    border: 1px solid #2A323D;
    border-radius: 6px;
    padding: 4px 10px;
    color: #E6EDF3;
    font-size: 11px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #1F2630;
    border-color: #2563EB;
    color: #FFFFFF;
}
QPushButton:checked {
    background-color: #2563EB;
    border: 1px solid #2563EB;
    color: #FFFFFF;
    font-weight: 600;
}
QScrollBar:vertical {
    background: #090E1A;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #2A323D;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #2563EB;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: #090E1A;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #2A323D;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #2563EB;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QAbstractScrollArea::corner {
    background: #090E1A;
    border: none;
}
/* Panels and 36px flush subheaders */
ComputerSelectPanel, QWidget#ComputerSelectPanel {
    background-color: #090E1A;
    border-right: 1px solid #21262D;
}
ComputerInspectorPanel, QWidget#ComputerInspectorPanel {
    background-color: #090E1A;
    border-left: 1px solid #21262D;
}
QFrame#selectHeader, QFrame#inspectorHeader, QFrame#subHeader {
    background-color: #090E1A;
    border-bottom: 1px solid #21262D;
}
QLineEdit#filterLineEdit {
    margin: 0px 8px;
}
QPushButton#saveListButton {
    margin: 0px 8px;
}
/* Universal Dark Modals, Dialogs, SpinBoxes & Buttons */
QDialog {
    background-color: #090E1A;
    color: #E6EDF3;
    border: 1px solid #2A323D;
}
QDialog QLabel {
    color: #E6EDF3;
    font-size: 12px;
}
QSpinBox, QDoubleSpinBox, QDialog QSpinBox, QDialog QDoubleSpinBox {
    background-color: #0F172A;
    color: #E6EDF3;
    border: 1px solid #2A323D;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 13px;
    font-weight: bold;
    min-width: 65px;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2563EB;
}
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #1F2630;
    border: none;
    width: 18px;
}
QDialog QPushButton, QDialog QDialogButtonBox QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    font-weight: 600;
    border: 1px solid #2563EB;
    border-radius: 6px;
    padding: 6px 16px;
    min-width: 75px;
}
QDialog QPushButton:hover, QDialog QDialogButtonBox QPushButton:hover {
    background-color: #2563EB;
}
QDialog QPushButton[text*="Cancel"], QDialog QDialogButtonBox QPushButton[text*="Cancel"] {
    background-color: #0F172A;
    color: #8B949E;
    border: 1px solid #2A323D;
}
QDialog QPushButton[text*="Cancel"]:hover, QDialog QDialogButtonBox QPushButton[text*="Cancel"]:hover {
    background-color: #1F2630;
    color: #E6EDF3;
}
QDialog QLineEdit {
    background-color: #0F172A;
    color: #E6EDF3;
    border: 1px solid #2A323D;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}
QDialog QTextEdit, QDialog QPlainTextEdit {
    background-color: #0F172A;
    color: #E6EDF3;
    border: 1px solid #2A323D;
    border-radius: 6px;
    padding: 6px;
    font-size: 12px;
}

/* Screenshot Management Panel */
ScreenshotManagementPanel, QWidget#ScreenshotManagementPanel {
    background-color: #090E1A;
    border-right: 1px solid #2A323D;
}
ScreenshotManagementPanel QListView#list {
    background-color: #0F172A;
    color: #E6EDF3;
    border: 1px solid #2A323D;
    border-radius: 6px;
    font-size: 11px;
    padding: 4px;
}
ScreenshotManagementPanel QListView#list::item {
    padding: 6px 8px;
    border-radius: 4px;
    color: #E6EDF3;
    margin-bottom: 2px;
}
ScreenshotManagementPanel QListView#list::item:hover {
    background-color: #1F2630;
    color: #FFFFFF;
}
ScreenshotManagementPanel QListView#list::item:selected {
    background-color: #2563EB;
    color: #FFFFFF;
    font-weight: bold;
}
ScreenshotManagementPanel QLabel {
    color: #8B949E;
    font-size: 11px;
}
ScreenshotManagementPanel QLabel#previewLbl {
    background-color: #0F172A;
    border: 1px solid #2A323D;
    border-radius: 6px;
    min-height: 120px;
}
QLabel#userDescLbl, QLabel#dateDescLbl, QLabel#timeDescLbl, QLabel#hostDescLbl,
ScreenshotManagementPanel QLabel#userDescLbl, ScreenshotManagementPanel QLabel#dateDescLbl,
ScreenshotManagementPanel QLabel#timeDescLbl, ScreenshotManagementPanel QLabel#hostDescLbl {
    color: #38BDF8 !important;
    font-weight: 700;
    font-size: 11px;
}
QLabel#userLbl, QLabel#dateLbl, QLabel#timeLbl, QLabel#hostLbl,
ScreenshotManagementPanel QLabel#userLbl, ScreenshotManagementPanel QLabel#dateLbl,
ScreenshotManagementPanel QLabel#timeLbl, ScreenshotManagementPanel QLabel#hostLbl {
    color: #E6EDF3 !important;
    font-weight: 600;
    font-size: 11px;
}
ScreenshotManagementPanel QPushButton#showBtn {
    background-color: #2563EB;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 11px;
    border: 1px solid #2563EB;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 28px;
}
ScreenshotManagementPanel QPushButton#showBtn:hover {
    background-color: #2563EB;
}
ScreenshotManagementPanel QPushButton#deleteBtn {
    background-color: #0F172A;
    color: #F87171;
    font-weight: 600;
    font-size: 11px;
    border: 1px solid #7F1D1D;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 28px;
}
ScreenshotManagementPanel QPushButton#deleteBtn:hover {
    background-color: #7F1D1D;
    color: #FFFFFF;
}

